{
    "version": 2,
    "configurePresets": [
        {
            "name": "msvc",
            "hidden": true,
            "environment": {
                "COMMONLIBSSE_TEXT": "-DUNICODE -D_UNICODE",
                "COMMONLIBSSE_PLATFORM": "-DWIN32_LEAN_AND_MEAN -DNOMINMAX",
                "COMMONLIBSSE_COMPILER": "/permissive- /Zc:preprocessor /EHsc $penv{CXXFLAGS}"
            },
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "$env{COMMONLIBSSE_COMPILER} $env{COMMONLIBSSE_PLATFORM} $env{COMMONLIBSSE_TEXT}",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
                "VCPKG_HOST_TRIPLET": "x64-windows-static-md",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "intelliSenseMode": "windows-msvc-x64",
                    "enableMicrosoftCodeAnalysis": true,
                    "enableClangTidyCodeAnalysis": true
                }
            },
            "architecture": {
                "value": "x64",
                "strategy": "set"
            }
        },
        {
            "name": "base",
            "displayName": "Release Build",
            "description": "Release Build for VS2022",
            "inherits": ["msvc"],
            "binaryDir": "${sourceDir}/build",
            "generator": "Visual Studio 17 2022",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_BUILD_TYPE": {
                    "type": "STRING",
                    "value": "Release"
                }
            }
        },
        {
            "name": "build",
            "inherits": ["base"],
            "binaryDir": "${sourceDir}/build-163",
            "cacheVariables": {
                "FOMOD_PACKAGE": "01 DLL_163",
                "COMMONLIB_DIR": "CommonLibF4-163"
            }
        },
        {
            "name": "build-984",
            "inherits": ["base"],
            "binaryDir": "${sourceDir}/build-984",
            "cacheVariables": {
                "FOMOD_PACKAGE": "01 DLL_984",
                "COMMONLIB_DIR": "CommonLibF4-984"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build",
            "configurePreset": "build",
            "displayName": "Build DLL for FO4 ",
            "description": "Optimized release build."
        },
        {
