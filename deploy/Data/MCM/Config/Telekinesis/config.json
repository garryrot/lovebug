            "pageDisplayName": "Devices",
            "content": [
                {
                    "text": "<font size='24'>Device Settings</font><br /><p align='center'><font size='14'>Each device motor can be configured separately and is disabled by default. Use 'Prev' and 'Next' to select device...</font></p>",
