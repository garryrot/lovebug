{
    "modName": "Telekinesis",
    "displayName": "Telekinesis",
    "minMcmVersion": 2,
    "pluginRequirements": [
        "Telekinesis.esp"
    ],
    "content": [
		{
			"text": "<font size='48'>Telekinesis</font><br /><p align='center'><font size='24'>Version 2.0</font></p>",
			"type": "text",
			"html": true
		},
        {
            "text": "Connection Method",
            "type": "section"
        },
        {
            "id": "iType:Connection",
            "text": "Type",
            "type": "stepper",
            "help": "",
            "valueOptions": {
              "sourceType": "ModSettingInt",
              "options": ["In-Process", "WebSocket", "None"]
            },
            "groupControl": 1
        },
        {
            "id": "sHost:Connection",
            "text": "Host",
            "type": "textinput",
            "help": "Hostname of Intiface Central (or other Buttplug server)",
            "valueOptions": {
                "sourceType": "ModSettingString"
            },
            "groupCondition": 1
        },
        {
            "id": "sPort:Connection",
            "text": "Port",
            "type": "textinput",
            "help": "Port of Intiface Central (0 - 65535)",
            "valueOptions": {
                "sourceType": "ModSettingString"
            },
            "groupCondition": 1
        },
        {
            "text": "Reconnt Now...",
            "type": "button",
            "help": "",
            "action": {
                "type": "CallFunction",
                "form": "Telekinesis.esp|1732",
                "scriptName": "TK2:Main",
                "function": "Reconnect"
            }
        },
		{
			"text": "<p align='center'><font size='18'>Run Intiface Central app, start the server and enter hostname and port.</font></p>",
			"type": "text",
			"html": true,
            "groupCondition": 1
		},
        {
            "text": "Modules",
            "type": "section"
        },
        {
            "id": "bBluetooth:Connection",
            "text": "Bluetooth",
            "help": "",
            "type": "switcher",
            "valueOptions": {
                "sourceType": "ModSettingBool"
            }
        },
        {
            "id": "bXInput:Connection",
            "text": "X-Input",
            "help": "",
            "type": "switcher",
            "valueOptions": {
                "sourceType": "ModSettingBool"
            }
        },
        {
            "id": "bSerial:Connection",
            "text": "Serial",
            "help": "",
            "type": "switcher",
            "valueOptions": {
                "sourceType": "ModSettingBool"
            }
        },
		{
			"text": "<p align='center'><font size='18'>Controls which hardware can be accessed by In-Process connection. Change this if you don't want certain hardware to be utilized by Telekinesis.</font></p>",
			"type": "text",
			"html": true
		}
    ],
    "pages": [
